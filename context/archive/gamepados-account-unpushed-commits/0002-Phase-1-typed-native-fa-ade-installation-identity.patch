+                @android.webkit.JavascriptInterface
+                fun prefGet(key: String): String {
+                    return try {
+                        getSharedPreferences("gamepados", MODE_PRIVATE).getString(key, "") ?: ""
+                    } catch (t: Throwable) { "" }
+                }
+
+                @android.webkit.JavascriptInterface
+                fun prefSet(key: String, value: String) {
+                    try {
+                        getSharedPreferences("gamepados", MODE_PRIVATE)
+                            .edit().putString(key, value).apply()
+                    } catch (t: Throwable) { }
+                }
