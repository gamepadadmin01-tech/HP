-  updateProfile: (updates: Partial<NonNullable<User>>) => Promise<void>;
-  continueAsGuest: () => void;
-  hasSeenIntro: boolean;
-  markIntroSeen: () => void;
-}
-
-const AuthContext = createContext<AuthState | null>(null);
-
-export function AuthProvider({ children }: { children: React.ReactNode }) {
-  const [user, setUser] = useState<User>(() => {
-    try {
-      const saved = localStorage.getItem("auth_user");
-      return saved ? JSON.parse(saved) : null;
-    } catch { return null; }
-  });
-
-  const isGuest = user === null;
-
-  const [hasSeenIntro, setHasSeenIntro] = useState<boolean>(() => {
-    try { return localStorage.getItem("auth_intro_seen") === "true"; } catch { return false; }
-  });
-
-  useEffect(() => {
-    localStorage.setItem("auth_user", user ? JSON.stringify(user) : "");
-    localStorage.setItem("auth_intro_seen", hasSeenIntro ? "true" : "false");
-  }, [user, hasSeenIntro]);
-
-  const login = async (email: string, pass: string) => {
-    const { data, error } = await supabase.auth.signInWithPassword({ email, password: pass });
-    if (error) throw error;
-    setUser({ name: data.user?.user_metadata?.name || email.split("@")[0], email });
-  };
-
-  const signup = async (name: string, email: string, pass: string) => {
-    const { data, error } = await supabase.auth.signUp({ 
-      email, 
-      password: pass,
-      options: { data: { name, createdAt: new Date().toISOString() } }
-    });
-    if (error) throw error;
-    setUser({ 
-      name, 
-      email,
-      createdAt: data.user?.user_metadata?.createdAt || new Date().toISOString() 
-    });
-  };
-
-  const logout = async () => {
-    await supabase.auth.signOut();
-    setUser(null);
-  };
-
-  const updateProfile = async (updates: Partial<NonNullable<User>>) => {
-    if (!user) return;
-    const { data, error } = await supabase.auth.updateUser({
-      data: updates
-    });
-    if (error) throw error;
-    setUser({ ...user, ...updates });
-  };
-
-  const continueAsGuest = () => {
-    setIsGuest(true);
-    markIntroSeen();
-  };
-
-  const markIntroSeen = () => {
-    setHasSeenIntro(true);
-  };
-
-  return (
-    <AuthContext.Provider value={{ user, isGuest, login, signup, logout, updateProfile, continueAsGuest, hasSeenIntro, markIntroSeen }}>
-      {children}
-    </AuthContext.Provider>
-  );
-}
