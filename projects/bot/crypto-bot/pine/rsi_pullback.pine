//@version=5
// RSI pullback (dip-buy) inside an uptrend, long only. Use on the daily (1D) chart.
// Entry : close above SMA200 and RSI(14) crosses below 40 -> buy next open
// Exit  : RSI(14) above 65, or after 15 bars
// Stop  : 2.5 x ATR(14) below entry
strategy("Dip-buy (RSI pullback in uptrend)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

r = ta.rsi(close, 14)
m = ta.sma(close, 200)
a = ta.atr(14)
rsiDown = ta.crossunder(r, 40)
dip = close > m and rsiDown

var float stopPx = na
var int entryBar = na
if strategy.position_size == 0 and dip
    strategy.entry("Long", strategy.long)
    stopPx := close - 2.5 * a
    entryBar := bar_index
if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=stopPx)
    if r > 65 or bar_index - entryBar >= 15
        strategy.close("Long", comment=r > 65 ? "RSI > 65" : "time exit")

plot(m, "SMA200", color.gray, 2)
plot(strategy.position_size > 0 ? stopPx : na, "Stop", color.red, style=plot.style_linebr)
alertcondition(dip, "Dip buy", "RSI dip BUY {{ticker}} close {{close}}")
