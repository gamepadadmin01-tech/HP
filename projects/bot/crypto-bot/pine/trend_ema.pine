//@version=5
// EMA 20/50 trend follower with EMA 200 filter, long only. Use on the daily (1D) chart.
// Entry : EMA20 crosses above EMA50 while close is above EMA200 -> buy next open
// Exit  : EMA20 crosses below EMA50, or the trailing stop is hit
// Stop  : 3 x ATR(14) below entry, trailed 3 x ATR below the highest close since entry
strategy("Trend (EMA 20/50 + 200 filter)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

atrMult = input.float(3.0, "Trailing stop = ATR x")

f = ta.ema(close, 20)
s = ta.ema(close, 50)
t = ta.ema(close, 200)
a = ta.atr(14)
crossUp = ta.crossover(f, s)
crossDn = ta.crossunder(f, s)

var float stopPx = na
var float peak = na
if strategy.position_size == 0 and crossUp and close > t
    strategy.entry("Long", strategy.long)
    stopPx := close - atrMult * a
    peak := close
if strategy.position_size > 0
    peak := math.max(peak, close)
    stopPx := math.max(stopPx, peak - atrMult * a)
    strategy.exit("Trail", "Long", stop=stopPx)
    if crossDn
        strategy.close("Long", comment="EMA cross down")

plot(f, "EMA20", color.teal)
plot(s, "EMA50", color.orange)
plot(t, "EMA200", color.gray, 2)
plot(strategy.position_size > 0 ? stopPx : na, "Stop", color.red, style=plot.style_linebr)
alertcondition(crossUp and close > t, "Trend buy", "EMA trend BUY {{ticker}} close {{close}}")
alertcondition(crossDn, "Trend sell", "EMA trend SELL {{ticker}} close {{close}}")
