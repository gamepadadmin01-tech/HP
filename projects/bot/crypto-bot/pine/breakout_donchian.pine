//@version=5
// Donchian 20/10 breakout, long only. Use on the daily (1D) chart of BINANCE:BTCUSDT or BINANCE:ETHUSDT.
// Entry : daily close above the previous 20-day high -> buy next open
// Exit  : daily close below the previous 10-day low -> sell next open
// Stop  : 2 x ATR(14) below the entry price
//
// Webhook: create an alert on this strategy, condition "Order fills only", webhook URL
// https://<your-ngrok-host>/webhook, and paste this as the alert message:
//   {"secret": "YOUR_WEBHOOK_SECRET", "order": {{strategy.order.alert_message}}}
strategy("Breakout (Donchian 20/10)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

entryLen = input.int(20, "Entry lookback (days)")
exitLen  = input.int(10, "Exit lookback (days)")
atrMult  = input.float(2.0, "Stop = ATR x")

hiN = ta.highest(high, entryLen)[1]
loN = ta.lowest(low, exitLen)[1]
a   = ta.atr(14)

sym = syminfo.ticker
buyMsg  = '{"action": "buy", "symbol": "' + sym + '", "stop_dist": ' + str.tostring(atrMult * a, "#.########") + ', "comment": "20-day high breakout"}'
stopMsg = '{"action": "sell", "symbol": "' + sym + '", "comment": "stop-loss on chart"}'
exitMsg = '{"action": "sell", "symbol": "' + sym + '", "comment": "10-day low"}'

var float stopPx = na
if strategy.position_size == 0 and close > hiN
    strategy.entry("Long", strategy.long, alert_message=buyMsg)
    stopPx := close - atrMult * a
if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=stopPx, alert_message=stopMsg)
    if close < loN
        strategy.close("Long", comment="10-day low", alert_message=exitMsg)

plot(hiN, "20-day high", color.new(color.green, 0))
plot(loN, "10-day low", color.new(color.red, 0))
plot(strategy.position_size > 0 ? stopPx : na, "Stop", color.orange, style=plot.style_linebr)
