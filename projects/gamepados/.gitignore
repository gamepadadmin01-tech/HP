# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — never commit. Losing these is bad; leaking them is worse.
# ─────────────────────────────────────────────────────────────────────────────
secrets/
.env
.env.*
!.env.example
*.env
**/release.keystore
*.keystore
*.jks
*.pem
*.p12
*.pfx
keystore.properties
local.properties

# ─────────────────────────────────────────────────────────────────────────────
# Its own git repo — tracked separately as gamepadadmin01-tech/gamepad
# ─────────────────────────────────────────────────────────────────────────────
website/

# ─────────────────────────────────────────────────────────────────────────────
# Regenerable build output — see context/REBUILD.md
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.cargo/
.rustup/
target/
build/
.gradle/
.kotlin/
.cxx/
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Vite / bundler output. NOTE: apps/android-client/.../assets/dist/index.html is
# NOT ignored — the APK ships it and it must be tracked.
apps/controller-ui/dist/
!apps/android-client/app/src/main/assets/dist/

# ─────────────────────────────────────────────────────────────────────────────
# Pinned toolchain — ~455 MB of JDK + Gradle + platform-tools, plus the installer
# .exe files. Kept on disk, not in git. Reinstall per context/REBUILD.md.
# DO NOT DELETE FROM DISK.
#
# The hand-written SCRIPTS in here are a different matter and ARE tracked (~44 KB
# total). `tools/` used to be ignored wholesale, which quietly left
# regression-check.sh — the safety net the release checklist tells us to run after
# every significant change — with no backup at all, on a drive that has already
# been formatted once. build_exact_composite.py and create_stacked_promo.py are in
# the same boat, and CLAUDE.md names them as files that must be edited by hand
# whenever a folder moves.
# ─────────────────────────────────────────────────────────────────────────────
tools/*
!tools/*.sh
!tools/*.ps1
!tools/*.mjs
!tools/*.js
!tools/*.py
!tools/scripts/

# ─────────────────────────────────────────────────────────────────────────────
# Large binaries — these belong in cloud storage, not git
# ─────────────────────────────────────────────────────────────────────────────
*.apk
*.aab
*.exe
*.msi
*.zip
*.7z
*.mp4
*.mov
*.avi
*.psd
releases/
marketing/ad-footage/
photos/
Screenshots/
store-assets/

# ─────────────────────────────────────────────────────────────────────────────
# Logs, temp, scratch
# ─────────────────────────────────────────────────────────────────────────────
*.log
*.hprof
*.bak
*.bak-*
*.tmp
*.orig
_recovery_backups/
_preserve_pre-slim/
.vscode/
.DS_Store
Thumbs.db
