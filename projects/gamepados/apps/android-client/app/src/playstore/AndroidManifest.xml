<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Preserve the owner's current Play configuration; other distributions
             inherit resizability from main. This is NOT a Play policy requirement.
             Android 16+ can ignore this restriction on large screens. -->
        <activity
            android:name=".MainActivity"
            android:resizeableActivity="false"
            tools:replace="android:resizeableActivity" />
    </application>
</manifest>
