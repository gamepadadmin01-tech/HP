<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Play build no longer overrides resizeableActivity to "false".
         It inherits "true" from main, like every other distribution (owner's call,
         2026-09-27). Android 16 ignores the restriction on tablets and foldables
         anyway, and Play Console flagged it ("Remove resizability and orientation
         restrictions"). MainActivity declares screenLayout in configChanges so a
         window resize never recreates the activity mid-session: the controller's
         orientation lock and the large-screen letterbox are applied at runtime
         (setScreenOrientation / applyLetterboxing), not by this manifest. -->
    <application>
        <!-- AdMob app id (rewarded ads). The SDK refuses to start without it. The admobAppId placeholder is
             Google's test id in debug builds and the live one in release (build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>
</manifest>
